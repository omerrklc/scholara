{
  "expo": {
    "name": "Scholara",
    "slug": "scholara",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "scholara",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scholara.app"
    },
    "android": {
      "package": "com.scholara.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E9F4F1"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Scholara to access the photo you choose for your academic profile."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80e885fb-8df2-4262-8972-f07ace845921"
      }
    },
    "owner": "sentema"
  }
}
